# Copy to .env (docker compose reads it automatically). Never commit .env.

# --- Secrets: set random values for anything beyond your laptop ---
JWT_SECRET=            # openssl rand -base64 48
DB_PASSWORD=
GRAFANA_PASSWORD=

# --- LLM (optional). Any OpenAI-compatible endpoint: Gemini, OpenAI, Groq, Ollama ---
LLM_ENABLED=false
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
